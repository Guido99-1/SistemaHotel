@inject IClienteServicio _clienteServicio
@attribute [Authorize(Roles = "Administrador,Gerencia,Reservas,Recepcionista")]
@inject ISnackbar _snackBar

<MudDialog Style="width: 500px;">

    <DialogContent>
        <MudContainer Class="m-0 p-0">

            <EditForm Model="@_cliente">

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   @bind-Value="@_cliente.TipoDocumento"
                                   Label="Tipo Documento"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Filled.Badge"
                                   AnchorOrigin="Origin.BottomCenter"
                                   For="@(() => _cliente.TipoDocumento)">
                            <MudSelectItem Value="@("Cédula")">Cédula</MudSelectItem>
                            <MudSelectItem Value="@("RUC")">RUC</MudSelectItem>
                            <MudSelectItem Value="@("Pasaporte")">Pasaporte</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="@_cliente.Documento"
                                      Label="Documento"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Badge"
                                      For="@(() => _cliente.Documento)" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="@_cliente.NombreCompleto"
                                      Label="Nombre Completo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Person"
                                      For="@(() => _cliente.NombreCompleto)" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="@_cliente.Correo"
                                      Label="Correo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      For="@(() => _cliente.Correo)" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="@_cliente.Telefono"
                                      Label="Telefono"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Phone"
                                      For="@(() => _cliente.Telefono)" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="@_cliente.Direccion"
                                      Label="Direccion"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.LocationOn"
                                      For="@(() => _cliente.Direccion)" />
                    </MudItem>
                </MudGrid>

            </EditForm>

        </MudContainer>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public ClienteDTO _cliente { get; set; } = new ClienteDTO();


    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {

    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_cliente.TipoDocumento) || string.IsNullOrWhiteSpace(_cliente.Documento) || 
        string.IsNullOrWhiteSpace(_cliente.NombreCompleto) || string.IsNullOrWhiteSpace(_cliente.Correo) 
        || string.IsNullOrWhiteSpace(_cliente.Telefono) || string.IsNullOrWhiteSpace(_cliente.Direccion)
        )
            return;

        string _mensaje = "";
        bool _resultado;

        if (_cliente.IdCliente != 0)
        {
            _resultado = await _clienteServicio.Editar(_cliente);
            _mensaje = "Cliente fue modificado";
        }
        else
        {
            var response = await _clienteServicio.Crear(_cliente);
            _resultado = response.status;
            _mensaje = "Cliente fue creado";
        }

        if (_resultado)
        {
            _snackBar.Add(_mensaje, Severity.Success, a => a.VisibleStateDuration = 1000);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
            _snackBar.Add("Error al guardar cambios", Severity.Error, a => a.VisibleStateDuration = 1000);

    }
}
