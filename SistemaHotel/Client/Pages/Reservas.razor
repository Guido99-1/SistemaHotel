@code {
    private int _tabIndex = 0;
    private IEnumerable<Claim>? debugClaims;
    private bool esAdmin;
    private bool esGerencia;

    private DateTime? fechaInicioFiltro = DateTime.Today.AddDays(1);
    private DateTime? minDESDE = DateTime.Today.AddDays(1);
    private DateTime? fechaFinFiltro = DateTime.Today.AddDays(2);

    private DateTime? _fiInicial;
    private DateTime? _ffInicial;
    private bool cargando = false;
    private bool _fechasTocadas = false;

    private bool RangoValido =>
        fechaInicioFiltro.HasValue && fechaFinFiltro.HasValue &&
        fechaFinFiltro.Value.Date > fechaInicioFiltro.Value.Date;

    private bool PuedeAplicar => _fechasTocadas && RangoValido;

    private HashSet<int> habitacionesBloqueadas = new();
    private HashSet<string> habitacionesReservadasHoy = new();

    List<PisoDTO> listaPisos = new();
    PisoDTO? pisoSeleccionado;
    List<HabitacionDTO>? listaHabitaciones = new();

    // KPIs Habitaciones
    private int HabDisponibles => listaHabitaciones?.Count(h => h.IdEstadoHabitacion == 1 && !habitacionesBloqueadas.Contains(h.IdHabitacion)) ?? 0;
    private int HabReservadasHoyCount => listaHabitaciones?.Count(h => habitacionesReservadasHoy.Contains(h.Numero)) ?? 0;

    private DateTime? fechaInicioListado = DateTime.Today;
    private DateTime? fechaFinListado = DateTime.Today;
    private DateTime? fechaInicio = DateTime.Today;
    private DateTime? fechaFin = DateTime.Today;
    private bool cargandoListado = false;
    private List<ReservaReporteDTO> listaReservasListado = new();

    private ClienteDTO? clienteSeleccionadoListado;
    private HabitacionDTO? habitacionSeleccionadaListado;
    private bool soloConSaldoPendiente = false;

    private string _periodoActivo = "";

    private int FiltrosActivos
    {
        get
        {
            int count = 0;
            if (clienteSeleccionadoListado != null) count++;
            if (habitacionSeleccionadaListado != null) count++;
            if (soloConSaldoPendiente) count++;
            return count;
        }
    }

    private void AplicarPeriodo(string periodo)
    {
        var hoy = DateTime.Today;
        _periodoActivo = periodo;

        switch (periodo)
        {
            case "HOY":
                fechaInicioListado = hoy;
                fechaFinListado = hoy;
                break;
            case "SEMANA":
                int diff = (7 + (int)hoy.DayOfWeek - (int)DayOfWeek.Monday) % 7;
                fechaInicioListado = hoy.AddDays(-diff);
                fechaFinListado = fechaInicioListado.Value.AddDays(6);
                break;
            case "MES":
                fechaInicioListado = new DateTime(hoy.Year, hoy.Month, 1);
                fechaFinListado = fechaInicioListado.Value.AddMonths(1).AddDays(-1);
                break;
            case "MES_ANTERIOR":
                var primerDiaMesAnterior = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1);
                fechaInicioListado = primerDiaMesAnterior;
                fechaFinListado = primerDiaMesAnterior.AddMonths(1).AddDays(-1);
                break;
        }
    }

    private List<ClienteDTO> listaClientesParaFiltro = new();
    private List<HabitacionDTO> listaHabitacionesParaFiltro = new();

    private Task<IEnumerable<ClienteDTO>> BuscarClientesListado(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return Task.FromResult<IEnumerable<ClienteDTO>>(listaClientesParaFiltro.Take(10));

        var resultado = listaClientesParaFiltro
            .Where(c => (c.NombreCompleto ?? "").Contains(valor, StringComparison.OrdinalIgnoreCase)
                     || (c.Documento ?? "").Contains(valor, StringComparison.OrdinalIgnoreCase))
            .Take(20);

        return Task.FromResult<IEnumerable<ClienteDTO>>(resultado);
    }

    private List<ReservaReporteDTO> ListaReservasFiltradas
    {
        get
        {
            IEnumerable<ReservaReporteDTO> q = listaReservasListado;

            if (clienteSeleccionadoListado != null)
                q = q.Where(x => x.NombreCliente == clienteSeleccionadoListado.NombreCompleto);

            if (habitacionSeleccionadaListado != null)
                q = q.Where(x => x.NroHabitacion == habitacionSeleccionadaListado.Numero);

            if (soloConSaldoPendiente)
                q = q.Where(x => x.ValorPendiente > 0);

            return q.ToList();
        }
    }

    private decimal TotalReservas => ListaReservasFiltradas.Sum(x => x.Total);
    private decimal TotalCancelado => ListaReservasFiltradas.Sum(x => x.ValorCancelado);
    private decimal TotalPendiente => ListaReservasFiltradas.Sum(x => x.ValorPendiente);

    private async Task<string> ObtenerUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User?.Identity?.Name ?? "Sistema";
    }

    private string ConstruirSubtituloListado()
    {
        var partes = new List<string>
        {
            $"Período: {fechaInicioListado:dd/MM/yyyy} - {fechaFinListado:dd/MM/yyyy}"
        };

        if (clienteSeleccionadoListado != null) partes.Add($"Cliente: {clienteSeleccionadoListado.NombreCompleto}");
        if (habitacionSeleccionadaListado != null) partes.Add($"Habitación: {habitacionSeleccionadaListado.Numero}");
        if (soloConSaldoPendiente) partes.Add("Solo con saldo pendiente");

        return string.Join(" | ", partes);
    }

    protected override async Task OnInitializedAsync()
    {
        _fiInicial = fechaInicioFiltro?.Date;
        _ffInicial = fechaFinFiltro?.Date;

        var responsePiso = await _pisoServicio.Lista();
        if (!responsePiso.status || responsePiso.value is null)
        {
            listaPisos = new();
            listaHabitaciones = new();
            return;
        }

        listaPisos = responsePiso.value as List<PisoDTO> ?? new List<PisoDTO>();

        if (!listaPisos.Any())
        {
            listaHabitaciones = new();
            return;
        }

        pisoSeleccionado = listaPisos.First();
        await ObtenerHabitaciones(pisoSeleccionado.IdPiso);

        await CargarHabitacionesReservadasHoy();

        var respClientes = await _clienteServicio.Lista();
        if (respClientes.status && respClientes.value != null)
            listaClientesParaFiltro = respClientes.value;

        var respTodasHabitaciones = await _habitacionServicio.Lista();
        if (respTodasHabitaciones.status && respTodasHabitaciones.value != null)
            listaHabitacionesParaFiltro = respTodasHabitaciones.value.OrderBy(h => h.Numero).ToList();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        debugClaims = user.Claims;

        esAdmin = user.IsInRole("Administrador");
        esGerencia = user.IsInRole("Gerencia");
    }

    private async Task CargarHabitacionesReservadasHoy()
    {
        try
        {
            var hoy = DateTime.Today.ToString("dd/MM/yyyy");
            var resp = await _reservaServicio.FiltrarListado(hoy, hoy);

            if (resp.status && resp.value != null)
            {
                habitacionesReservadasHoy = resp.value
                    .Where(r => r.EstadoReserva == "RESERVADA" || r.EstadoReserva == "CONFIRMADA")
                    .Select(r => r.NroHabitacion ?? "")
                    .Where(n => !string.IsNullOrEmpty(n))
                    .ToHashSet();
            }
            else
            {
                habitacionesReservadasHoy = new();
            }
        }
        catch
        {
            habitacionesReservadasHoy = new();
        }
    }

    private async Task ConfirmarEliminarReserva(int idReserva)
    {
        var confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar reserva?",
            Text = $"Se eliminará la reserva seleccionada.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!confirm.IsConfirmed)
            return;

        var resp = await _reservaServicio.Eliminar(idReserva);

        if (resp.status)
        {
            await Swal.FireAsync("Eliminada", "La reserva fue eliminada correctamente.", "success");
            await BuscarReservasListado();
        }
        else
        {
            await Swal.FireAsync("Error", resp.msg, "error");
        }
    }

    private async Task ObtenerHabitaciones(int idPiso)
    {
        var response = await _habitacionServicio.Lista();
        if (!response.status)
        {
            await Swal.FireAsync("Error en habitaciones", response.msg, "error");
            listaHabitaciones = new();
            return;
        }

        var todas = response.value as List<HabitacionDTO> ?? new List<HabitacionDTO>();
        listaHabitaciones = todas.Where(h => h.IdPiso == idPiso).ToList();
    }

    private async Task OnSelectedValueChanged(PisoDTO value)
    {
        pisoSeleccionado = value;
        await ObtenerHabitaciones(value.IdPiso);
    }

    private async Task AplicarFiltroFechas()
    {
        if (pisoSeleccionado is null)
        {
            await Swal.FireAsync("Sin piso", "Selecciona un piso primero.", "warning");
            return;
        }

        if (fechaInicioFiltro == null || fechaFinFiltro == null)
        {
            await Swal.FireAsync("Fechas requeridas", "Selecciona Desde y Hasta.", "warning");
            return;
        }

        var fi = fechaInicioFiltro.Value.Date;
        var ff = fechaFinFiltro.Value.Date;

        if (ff <= fi)
        {
            await Swal.FireAsync("Rango inválido", "La fecha Hasta debe ser mayor que Desde.", "warning");
            return;
        }

        var resp = await _habitacionServicio.OcupacionPorRango(
            fi.ToString("yyyy-MM-dd"),
            ff.ToString("yyyy-MM-dd")
        );

        if (!resp.status)
        {
            await Swal.FireAsync("Error", resp.msg, "error");
            return;
        }

        habitacionesBloqueadas = (resp.value ?? new List<int>()).ToHashSet();
        await ObtenerHabitaciones(pisoSeleccionado.IdPiso);
    }

    private async Task Reservar(HabitacionDTO modelo)
    {
        if (modelo.IdEstadoHabitacion == 1 && habitacionesReservadasHoy.Contains(modelo.Numero))
        {
            var confirm = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Habitación reservada",
                Html = $@"
                    <div style='text-align: left; padding: 10px;'>
                        <p>La habitación <b>{modelo.Numero}</b> tiene un check-in pendiente para hoy.</p>
                        <p style='color: #E8A668; margin-top: 12px;'>
                            <b>Si reservas para fechas futuras, asegúrate de no cruzar con esta reserva.</b>
                        </p>
                        <p>¿Deseas continuar con una nueva reserva para fechas futuras?</p>
                    </div>",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, continuar",
                CancelButtonText = "Cancelar"
            });

            if (!confirm.IsConfirmed)
                return;
        }

        _navManager.NavigateTo($"/page/detallereserva/{modelo.IdHabitacion}");
    }

    private Task OnFechaInicioChanged(DateTime? value)
    {
        fechaInicioFiltro = value;
        MarcarFechasTocadas();
        return Task.CompletedTask;
    }

    private Task OnFechaFinChanged(DateTime? value)
    {
        fechaFinFiltro = value;
        MarcarFechasTocadas();
        return Task.CompletedTask;
    }

    private void MarcarFechasTocadas()
    {
        var fi = fechaInicioFiltro?.Date;
        var ff = fechaFinFiltro?.Date;
        _fechasTocadas = (fi != _fiInicial) || (ff != _ffInicial);
    }

    private async Task AbrirModalEditar(int idReserva)
    {
        var parameters = new DialogParameters { ["IdReserva"] = idReserva };
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };

        var dialog = DialogService.Show<MdEditarReserva>("Editar Reserva", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await BuscarReservasListado();
    }

    private async Task BuscarReservasListado()
    {
        if (fechaInicioListado == null || fechaFinListado == null)
        {
            await Swal.FireAsync("Error", "Seleccione las fechas", "warning");
            return;
        }

        if (fechaFinListado.Value.Date < fechaInicioListado.Value.Date)
        {
            await Swal.FireAsync("Error", "La fecha 'Hasta' no puede ser menor que 'Desde'", "warning");
            return;
        }

        try
        {
            cargandoListado = true;

            var fi = fechaInicioListado.Value.ToString("dd/MM/yyyy");
            var ff = fechaFinListado.Value.ToString("dd/MM/yyyy");

            var response = await _reservaServicio.FiltrarListado(fi, ff);

            if (response.status)
                listaReservasListado = response.value ?? new();
            else
                await Swal.FireAsync("Error", response.msg, "error");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", ex.Message, "error");
        }
        finally
        {
            cargandoListado = false;
        }
    }

    private Task LimpiarListado()
    {
        fechaInicioListado = DateTime.Today;
        fechaFinListado = DateTime.Today;
        clienteSeleccionadoListado = null;
        habitacionSeleccionadaListado = null;
        soloConSaldoPendiente = false;
        _periodoActivo = "";
        listaReservasListado = new();
        return Task.CompletedTask;
    }

    private async Task ExportarExcelListado()
    {
        var data = ListaReservasFiltradas;
        if (!data.Any())
        {
            await Swal.FireAsync("Sin datos", "No hay reservas para exportar.", "warning");
            return;
        }

        var encabezados = new List<string>
        {
            "Cliente", "Habitación", "Entrada", "Salida", "Total", "Cancelado", "Pendiente", "Observación"
        };

        var datos = data.Select(r => new object[]
        {
            r.NombreCliente ?? "",
            r.NroHabitacion ?? "",
            r.FechaEntrada ?? "",
            r.FechaSalida ?? "",
            r.Total,
            r.ValorCancelado,
            r.ValorPendiente,
            r.Observacion ?? ""
        }).ToList();

        var anchos = new double[] { 30, 14, 14, 14, 14, 14, 14, 30 };
        var colsMoneda = new int[] { 4, 5, 6 };

        await _excelService.GenerarReporte(
            titulo: "Listado de Reservas",
            subtitulo: ConstruirSubtituloListado(),
            encabezados: encabezados,
            datos: datos,
            anchosColumnas: anchos,
            columnasMoneda: colsMoneda,
            usuarioGenerador: await ObtenerUsuario(),
            nombreArchivo: "Listado_Reservas",
            incluirTotales: true
        );
    }

    private async Task ExportarPdfListado()
    {
        var data = ListaReservasFiltradas;
        if (!data.Any())
        {
            await Swal.FireAsync("Sin datos", "No hay reservas para exportar.", "warning");
            return;
        }

        var encabezados = new List<string>
        {
            "Cliente", "Habitación", "Entrada", "Salida", "Total", "Cancelado", "Pendiente"
        };

        var datos = data.Select(r => new object[]
        {
            r.NombreCliente ?? "",
            r.NroHabitacion ?? "",
            r.FechaEntrada ?? "",
            r.FechaSalida ?? "",
            r.Total,
            r.ValorCancelado,
            r.ValorPendiente
        }).ToList();

        var totales = new List<TotalReporte>
        {
            new() { Etiqueta = "Total", Valor = TotalReservas },
            new() { Etiqueta = "Cancelado", Valor = TotalCancelado },
            new() { Etiqueta = "Pendiente", Valor = TotalPendiente }
        };

        await _pdfService.GenerarReporte(
            titulo: "Listado de Reservas",
            subtitulo: ConstruirSubtituloListado(),
            encabezados: encabezados,
            datos: datos,
            usuarioGenerador: await ObtenerUsuario(),
            nombreArchivo: "Listado_Reservas",
            totales: totales,
            orientacion: "landscape"
        );
    }
}
