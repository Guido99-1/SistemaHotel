@page "/page/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@inject IDashBoardServicio _dashboardServicio
@inject NavigationManager _navManager
@attribute [Authorize(Roles = "Administrador,Recepcionista,Reservas,Empleado,Gerencia")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-3 mb-4">

    <!-- ════════════════════════════════════════════════ -->
    <!-- HEADER MINIMALISTA                                -->
    <!-- ════════════════════════════════════════════════ -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; letter-spacing: -0.5px;">
                Dashboard
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 13px;">
                @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RecargarDatos"
                   Disabled="@_loading"
                   Size="Size.Small"
                   Style="text-transform: none; border-color: #D1D5DB; color: #374151;">
            Actualizar
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="pa-8">
            <MudProgressCircular Style="color: #5C8DC2;" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Style="color: #6B7280;">Cargando información...</MudText>
        </MudStack>
    }
    else
    {
        <!-- ════════════════════════════════════════════════ -->
        <!-- KPIs PRINCIPALES (diseño plano y pulcro)          -->
        <!-- ════════════════════════════════════════════════ -->
        <MudGrid Spacing="3" Class="mb-4">

            <!-- Ocupación Actual (AZUL) -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="kpi-card-flat cursor-pointer pa-4"
                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;"
                          @onclick="@(() => _navManager.NavigateTo("/page/recepcion"))">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div style="background: #EBF2F9; padding: 8px; border-radius: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.Hotel" Style="color: #5C8DC2; font-size: 24px;" />
                            </div>
                            <MudChip Size="Size.Small" Variant="Variant.Text"
                                     Style="background: #EBF2F9; color: #4A7AAD; font-weight: 600; font-size: 11px;">
                                @dto.TasaOcupacionActual.ToString("F0")%
                            </MudChip>
                        </MudStack>
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">OCUPACIÓN</MudText>
                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                @dto.TotalHabitacionesOcupadas<span style="color: #9CA3AF; font-size: 18px; font-weight: 400;">/@dto.TotalHabitaciones</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: #6B7280;">habitaciones</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Ingresos Hoy (VERDE) -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="kpi-card-flat pa-4"
                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div style="background: #EFF5EF; padding: 8px; border-radius: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Style="color: #6FA776; font-size: 24px;" />
                            </div>
                            <MudChip Size="Size.Small" Variant="Variant.Text"
                                     Style="background: #EFF5EF; color: #5C9163; font-weight: 600; font-size: 11px;">
                                @dto.CheckOutsHoy check-outs
                            </MudChip>
                        </MudStack>
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">INGRESOS HOY</MudText>
                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                $@dto.IngresosHoy.ToString("N0")
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: #6B7280;">@DateTime.Now.ToString("dd 'de' MMM", new System.Globalization.CultureInfo("es-ES"))</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Reservas Hoy (NARANJA) -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="kpi-card-flat cursor-pointer pa-4"
                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;"
                          @onclick="@(() => _navManager.NavigateTo("/page/reservas"))">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div style="background: #FAF1E7; padding: 8px; border-radius: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.EventNote" Style="color: #E8A668; font-size: 24px;" />
                            </div>
                            <MudChip Size="Size.Small" Variant="Variant.Text"
                                     Style="background: #FAF1E7; color: #B97A40; font-weight: 600; font-size: 11px;">
                                @dto.ReservasPendientesHoy pend.
                            </MudChip>
                        </MudStack>
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">RESERVAS HOY</MudText>
                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                @dto.TotalReservasHoy
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: #6B7280;">@dto.CheckInsHoy check-ins realizados</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Ingresos Mes (NEGRO/GRIS OSCURO) -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="kpi-card-flat pa-4"
                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div style="background: #F0F2F5; padding: 8px; border-radius: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="color: #424E5F; font-size: 24px;" />
                            </div>
                            @if (dto.IngresosMesAnterior > 0)
                            {
                                var diff = ((dto.IngresosMes - dto.IngresosMesAnterior) / dto.IngresosMesAnterior) * 100m;
                                var bg = diff >= 0 ? "#EFF5EF" : "#FAF1E7";
                                var color = diff >= 0 ? "#5C9163" : "#B97A40";
                                <MudChip Size="Size.Small" Variant="Variant.Text"
                                         Style="@($"background: {bg}; color: {color}; font-weight: 600; font-size: 11px;")">
                                    @(diff >= 0 ? "↑" : "↓") @Math.Abs(diff).ToString("F0")%
                                </MudChip>
                            }
                        </MudStack>
                        <div>
                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">INGRESOS MES</MudText>
                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                $@dto.IngresosMes.ToString("N0")
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: #6B7280;">$@dto.PromedioIngresoDia.ToString("N0") promedio/día</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ════════════════════════════════════════════════ -->
        <!-- TABS                                              -->
        <!-- ════════════════════════════════════════════════ -->
        <MudTabs Outlined="false" Position="Position.Top" Rounded="true" Border="false"
                 ApplyEffectsToContainer="true" PanelClass="pa-3" Class="mb-3"
                 Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">

            <!-- TAB 1: GRÁFICAS PROFESIONALES -->
            <MudTabPanel Text="Análisis" Icon="@Icons.Material.Filled.Analytics">
                <MudGrid Spacing="3">

                    <!-- ═════════════════════════════════════════════ -->
                    <!-- GRÁFICA DE CHECK-INS PROFESIONAL              -->
                    <!-- ═════════════════════════════════════════════ -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <!-- Header de la gráfica -->
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <div style="background: #EBF2F9; padding: 10px; border-radius: 10px;">
                                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color: #5C8DC2; font-size: 24px;" />
                                    </div>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Check-ins Diarios</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">
                                            Análisis de afluencia · @TotalCheckIns total · promedio @PromedioCheckIns.ToString("F1")/día
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <!-- Selector de tipo de gráfico -->
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                                    <MudButton OnClick="@(() => _tipoGraficaCheckIn = ChartType.Line)"
                                               Style="@GetEstiloBoton(_tipoGraficaCheckIn == ChartType.Line)">
                                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" />
                                    </MudButton>
                                    <MudButton OnClick="@(() => _tipoGraficaCheckIn = ChartType.Bar)"
                                               Style="@GetEstiloBoton(_tipoGraficaCheckIn == ChartType.Bar)">
                                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" />
                                    </MudButton>
                                </MudButtonGroup>
                            </MudStack>

                            <!-- Stats destacadas en la parte superior -->
                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">TOTAL DEL MES</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #1F2937; font-weight: 700;">@TotalCheckIns</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">check-ins</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #5C8DC2;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">PROMEDIO</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #4A7AAD; font-weight: 700;">@PromedioCheckIns.ToString("F1")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">por día</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #E8A668;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">DÍA PICO</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #B97A40; font-weight: 700;">@MaximoCheckIns</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">máximo</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #6FA776;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">HOY</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #5C9163; font-weight: 700;">@dto.CheckInsHoy</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">@dto.ReservasPendientesHoy pendientes</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>

                            @if (dto.OcupacionMes != null && dto.OcupacionMes.Count > 0 && dto.OcupacionMes.Any(x => x.Ocupadas > 0))
                            {
                                <div class="chart-container">
                                    <MudChart ChartType="@_tipoGraficaCheckIn"
                                              Labels="@LabelsOcup"
                                              ChartSeries="@SeriesOcupacion"
                                              Width="100%"
                                              Height="350px"
                                              ChartOptions="@OptOcupacion" />
                                </div>
                            }
                            else
                            {
                                <div class="empty-chart">
                                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Style="font-size: 64px; color: #D1D5DB;" />
                                    <MudText Typo="Typo.body2" Style="color: #6B7280;">Sin datos de check-ins en este mes</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- ═════════════════════════════════════════════ -->
                    <!-- GRÁFICA DE INGRESOS PROFESIONAL               -->
                    <!-- ═════════════════════════════════════════════ -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <div style="background: #EFF5EF; padding: 10px; border-radius: 10px;">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Style="color: #6FA776; font-size: 24px;" />
                                    </div>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Ingresos Diarios</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">
                                            Recaudación por día (checkouts confirmados)
                                        </MudText>
                                    </MudStack>
                                </MudStack>

                                <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                                    <MudButton OnClick="@(() => _tipoGraficaIngreso = ChartType.Line)"
                                               Style="@GetEstiloBoton(_tipoGraficaIngreso == ChartType.Line)">
                                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" />
                                    </MudButton>
                                    <MudButton OnClick="@(() => _tipoGraficaIngreso = ChartType.Bar)"
                                               Style="@GetEstiloBoton(_tipoGraficaIngreso == ChartType.Bar)">
                                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" />
                                    </MudButton>
                                </MudButtonGroup>
                            </MudStack>

                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">TOTAL DEL MES</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #1F2937; font-weight: 700;">$@dto.IngresosMes.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">recaudado</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #6FA776;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">PROMEDIO/DÍA</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #5C9163; font-weight: 700;">$@dto.PromedioIngresoDia.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">por día</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #E8A668;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">DÍA PICO</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #B97A40; font-weight: 700;">$@MaximoIngreso.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">máximo del mes</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #5C8DC2;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">PROMEDIO/RESERVA</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #4A7AAD; font-weight: 700;">$@dto.PromedioPorReserva.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">por reserva</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>

                            @if (dto.IngresosMesCheckout != null && dto.IngresosMesCheckout.Count > 0 && dto.IngresosMesCheckout.Any(x => x.Monto > 0))
                            {
                                <div class="chart-container">
                                    <MudChart ChartType="@_tipoGraficaIngreso"
                                              Labels="@LabelsIng"
                                              ChartSeries="@SeriesIngresos"
                                              Width="100%"
                                              Height="350px"
                                              ChartOptions="@OptIngresos" />
                                </div>

                                <!-- Comparativa con mes anterior -->
                                <MudDivider Class="my-3" Style="border-color: #E5E7EB;" />
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="4">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">Mes Anterior</MudText>
                                            <MudText Typo="Typo.h6" Style="color: #424E5F; font-weight: 600;">
                                                $@dto.IngresosMesAnterior.ToString("N2")
                                            </MudText>
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">Mes Actual</MudText>
                                            <MudText Typo="Typo.h6" Style="color: #5C9163; font-weight: 600;">
                                                $@dto.IngresosMes.ToString("N2")
                                            </MudText>
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">Variación</MudText>
                                            @if (dto.IngresosMesAnterior > 0)
                                            {
                                                var diff = ((dto.IngresosMes - dto.IngresosMesAnterior) / dto.IngresosMesAnterior) * 100m;
                                                var color = diff >= 0 ? "#5C9163" : "#B97A40";
                                                <MudText Typo="Typo.h6" Style="@($"color: {color}; font-weight: 600;")">
                                                    @(diff >= 0 ? "↑" : "↓") @Math.Abs(diff).ToString("F1")%
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.h6" Style="color: #6B7280;">Sin datos previos</MudText>
                                            }
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            }
                            else
                            {
                                <div class="empty-chart">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="font-size: 64px; color: #D1D5DB;" />
                                    <MudText Typo="Typo.body2" Style="color: #6B7280;">Sin datos de ingresos en este mes</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- ═════════════════════════════════════════════ -->
                    <!-- ESTADO DE HABITACIONES                        -->
                    <!-- ═════════════════════════════════════════════ -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px; height: 100%;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #F0F2F5; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Style="color: #424E5F; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Estado de Habitaciones</MudText>
                            </MudStack>

                            <MudStack Spacing="3">
                                <!-- Disponibles -->
                                <div>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                        <MudText Typo="Typo.body2" Style="color: #374151;">Disponibles</MudText>
                                        <MudText Typo="Typo.body2" Style="color: #5C9163; font-weight: 700;">@dto.TotalHabitacionesDisponibles</MudText>
                                    </MudStack>
                                    <div class="bar-bg">
                                        <div class="bar-fill" style="@($"width: {(dto.TotalHabitaciones > 0 ? (dto.TotalHabitacionesDisponibles * 100.0 / dto.TotalHabitaciones) : 0)}%; background: #6FA776;")"></div>
                                    </div>
                                </div>

                                <!-- Ocupadas -->
                                <div>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                        <MudText Typo="Typo.body2" Style="color: #374151;">Ocupadas</MudText>
                                        <MudText Typo="Typo.body2" Style="color: #4A7AAD; font-weight: 700;">@dto.TotalHabitacionesOcupadas</MudText>
                                    </MudStack>
                                    <div class="bar-bg">
                                        <div class="bar-fill" style="@($"width: {(dto.TotalHabitaciones > 0 ? (dto.TotalHabitacionesOcupadas * 100.0 / dto.TotalHabitaciones) : 0)}%; background: #5C8DC2;")"></div>
                                    </div>
                                </div>

                                <!-- En limpieza -->
                                <div>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                        <MudText Typo="Typo.body2" Style="color: #374151;">En limpieza</MudText>
                                        <MudText Typo="Typo.body2" Style="color: #B97A40; font-weight: 700;">@dto.TotalHabitacionesEnLimpieza</MudText>
                                    </MudStack>
                                    <div class="bar-bg">
                                        <div class="bar-fill" style="@($"width: {(dto.TotalHabitaciones > 0 ? (dto.TotalHabitacionesEnLimpieza * 100.0 / dto.TotalHabitaciones) : 0)}%; background: #E8A668;")"></div>
                                    </div>
                                </div>
                            </MudStack>

                            <MudDivider Class="my-3" Style="border-color: #E5E7EB;" />

                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="color: #6B7280;">Tasa actual</MudText>
                                    <MudText Typo="Typo.h6" Style="color: #4A7AAD; font-weight: 700;">@dto.TasaOcupacionActual.ToString("F0")%</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="color: #6B7280;">Promedio mes</MudText>
                                    <MudText Typo="Typo.h6" Style="color: #5C9163; font-weight: 700;">@dto.TasaOcupacionPromedioMes.ToString("F1")%</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <!-- ═════════════════════════════════════════════ -->
                    <!-- MÉTODOS DE PAGO                               -->
                    <!-- ═════════════════════════════════════════════ -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px; height: 100%;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #EBF2F9; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Style="color: #5C8DC2; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Métodos de Pago</MudText>
                            </MudStack>

                            @if (dto.DistribucionMetodosPago.Any())
                            {
                                <div class="donut-container">
                                    <MudChart ChartType="ChartType.Donut"
                                              InputData="@MetodosPagoData"
                                              InputLabels="@MetodosPagoLabels"
                                              ChartOptions="@OptMetodosPago"
                                              Width="180px"
                                              Height="180px" />
                                </div>

                                <MudStack Spacing="2" Class="mt-3">
                                    @foreach (var m in dto.DistribucionMetodosPago)
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <div style="@($"width: 10px; height: 10px; border-radius: 50%; background: {GetColorMetodo(m.Metodo)};")"></div>
                                                <MudText Typo="Typo.body2" Style="color: #374151;">@m.Metodo</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Style="color: #1F2937; font-weight: 600;">
                                                $@m.MontoTotal.ToString("N0") <span style="color: #6B7280;">(@m.Porcentaje.ToString("F0")%)</span>
                                            </MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: #6B7280;">Sin datos disponibles este mes</MudText>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- ═════════════════════════════════════════════ -->
                    <!-- OCUPACIÓN POR CATEGORÍA                       -->
                    <!-- ═════════════════════════════════════════════ -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #FAF1E7; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Style="color: #E8A668; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Ocupación por Categoría</MudText>
                            </MudStack>

                            @if (dto.OcupacionPorCategoria.Any())
                            {
                                <MudGrid Spacing="3">
                                    @foreach (var cat in dto.OcupacionPorCategoria)
                                    {
                                        <MudItem xs="12" sm="6" md="4">
                                            <div class="categoria-card">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                                    <MudText Typo="Typo.body1" Style="color: #1F2937; font-weight: 700;">@cat.Categoria</MudText>
                                                    <MudText Typo="Typo.body2" Style="@($"color: {GetColorPorcentaje(cat.Porcentaje)}; font-weight: 700;")">
                                                        @cat.Porcentaje.ToString("F0")%
                                                    </MudText>
                                                </MudStack>
                                                <div class="bar-bg mb-2">
                                                    <div class="bar-fill" style="@($"width: {cat.Porcentaje}%; background: {GetColorPorcentaje(cat.Porcentaje)};")"></div>
                                                </div>
                                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.caption" Style="color: #6B7280;">
                                                        @cat.Ocupadas / @cat.Total
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Style="color: #5C9163; font-weight: 600;">
                                                        $@cat.IngresoMes.ToString("N0")
                                                    </MudText>
                                                </MudStack>
                                            </div>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: #6B7280;">Sin datos disponibles</MudText>
                            }
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudTabPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- TAB 2: GERENCIA - INGRESOS                           -->
            <!-- ═══════════════════════════════════════════════════ -->
            <MudTabPanel Text="Gerencia" Icon="@Icons.Material.Filled.Diamond">
                <MudGrid Spacing="3">

                    <!-- KPIs de Gerencia -->
                    <MudItem xs="12">
                        <MudGrid Spacing="3">
                            <!-- Total Reservas Mes -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-4 kpi-gerencia"
                                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        <div style="background: #F0F2F5; padding: 8px; border-radius: 10px; width: fit-content;">
                                            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="color: #424E5F; font-size: 24px;" />
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">RESERVAS MES</MudText>
                                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                                @dto.TotalReservasGerenciaMes
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">@dto.TotalReservasGerenciaAnio en el año</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Ingresos Mes -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-4 kpi-gerencia"
                                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <div style="background: #EFF5EF; padding: 8px; border-radius: 10px;">
                                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="color: #6FA776; font-size: 24px;" />
                                            </div>
                                            @if (dto.IngresosGerenciaMesAnterior > 0)
                                            {
                                                var diff = ((dto.IngresosGerenciaMes - dto.IngresosGerenciaMesAnterior) / dto.IngresosGerenciaMesAnterior) * 100m;
                                                var bg = diff >= 0 ? "#EFF5EF" : "#FAF1E7";
                                                var color = diff >= 0 ? "#5C9163" : "#B97A40";
                                                <MudChip Size="Size.Small" Variant="Variant.Text"
                                                         Style="@($"background: {bg}; color: {color}; font-weight: 600; font-size: 11px;")">
                                                    @(diff >= 0 ? "↑" : "↓") @Math.Abs(diff).ToString("F0")%
                                                </MudChip>
                                            }
                                        </MudStack>
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">INGRESOS MES</MudText>
                                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                                $@dto.IngresosGerenciaMes.ToString("N0")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">vs $@dto.IngresosGerenciaMesAnterior.ToString("N0") anterior</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Días Normales -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-4 kpi-gerencia"
                                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        <div style="background: #EBF2F9; padding: 8px; border-radius: 10px; width: fit-content;">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Style="color: #5C8DC2; font-size: 24px;" />
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">DÍAS NORMALES</MudText>
                                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                                @dto.ReservasGerenciaNormal
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">tarifa $15/persona</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Días Festivos -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="pa-4 kpi-gerencia"
                                          Style="background: white; border: 1px solid #E5E7EB; border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        <div style="background: #FAF1E7; padding: 8px; border-radius: 10px; width: fit-content;">
                                            <MudIcon Icon="@Icons.Material.Filled.Star" Style="color: #E8A668; font-size: 24px;" />
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280; letter-spacing: 0.5px; font-size: 11px;">DÍAS FESTIVOS</MudText>
                                            <MudText Typo="Typo.h4" Style="color: #1F2937; font-weight: 700; line-height: 1.2;">
                                                @dto.ReservasGerenciaFestivo
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">tarifa $20/persona</MudText>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <!-- Resumen financiero gerencia -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <div style="background: #F0F2F5; padding: 10px; border-radius: 10px;">
                                        <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Style="color: #424E5F; font-size: 24px;" />
                                    </div>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Ingresos de Gerencia</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">Distribución diaria de reservas con tarifa especial</MudText>
                                    </MudStack>
                                </MudStack>

                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => _navManager.NavigateTo("/page/reservagerencia"))"
                                           Style="background: #424E5F; color: white; text-transform: none;">
                                    Nueva Reserva
                                </MudButton>
                            </MudStack>

                            <!-- Stats de gerencia -->
                            <MudGrid Spacing="2" Class="mb-3">
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">TOTAL MES</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #1F2937; font-weight: 700;">$@dto.IngresosGerenciaMes.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">@dto.TotalReservasGerenciaMes reservas</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #6FA776;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">TOTAL AÑO</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #5C9163; font-weight: 700;">$@dto.IngresosGerenciaAnio.ToString("N0")</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">@dto.TotalReservasGerenciaAnio reservas</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #5C8DC2;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">PROMEDIO/RESERVA</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #4A7AAD; font-weight: 700;">
                                            $@(dto.TotalReservasGerenciaMes > 0 ? (dto.IngresosGerenciaMes / dto.TotalReservasGerenciaMes).ToString("N0") : "0")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">por reserva</MudText>
                                    </div>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <div class="stat-block" style="border-left: 3px solid #E8A668;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">% DEL TOTAL</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #B97A40; font-weight: 700;">
                                            @(dto.IngresosMes > 0 ? ((dto.IngresosGerenciaMes / dto.IngresosMes) * 100).ToString("F0") : "0")%
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">del ingreso total</MudText>
                                    </div>
                                </MudItem>
                            </MudGrid>

                            @if (dto.IngresosGerenciaDiarios != null && dto.IngresosGerenciaDiarios.Count > 0 && dto.IngresosGerenciaDiarios.Any(x => x.Monto > 0))
                            {
                                <div class="chart-container">
                                    <MudChart ChartType="ChartType.Bar"
                                              Labels="@LabelsGerencia"
                                              ChartSeries="@SeriesGerencia"
                                              Width="100%"
                                              Height="320px"
                                              ChartOptions="@OptGerencia" />
                                </div>
                            }
                            else
                            {
                                <div class="empty-chart">
                                    <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Style="font-size: 64px; color: #D1D5DB;" />
                                    <MudText Typo="Typo.body2" Style="color: #6B7280;">No hay reservas de gerencia este mes</MudText>
                                    <MudText Typo="Typo.caption" Style="color: #9CA3AF;">Click en "Nueva Reserva" para crear una</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- Comparativa Normal vs Festivo -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px; height: 100%;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #FAF1E7; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Style="color: #E8A668; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Distribución de Tarifas</MudText>
                            </MudStack>

                            @if (dto.ReservasGerenciaNormal + dto.ReservasGerenciaFestivo > 0)
                            {
                                int total = dto.ReservasGerenciaNormal + dto.ReservasGerenciaFestivo;
                                double pctNormal = (dto.ReservasGerenciaNormal * 100.0) / total;
                                double pctFestivo = (dto.ReservasGerenciaFestivo * 100.0) / total;

                                <MudStack Spacing="3">
                                    <!-- Normal -->
                                    <div>
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <div style="width: 12px; height: 12px; background: #5C8DC2; border-radius: 3px;"></div>
                                                <MudText Typo="Typo.body2" Style="color: #374151;">Días Normales ($15/persona)</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Style="color: #4A7AAD; font-weight: 700;">
                                                @dto.ReservasGerenciaNormal (@pctNormal.ToString("F0")%)
                                            </MudText>
                                        </MudStack>
                                        <div class="bar-bg">
                                            <div class="bar-fill" style="@($"width: {pctNormal}%; background: #5C8DC2;")"></div>
                                        </div>
                                    </div>

                                    <!-- Festivo -->
                                    <div>
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <div style="width: 12px; height: 12px; background: #E8A668; border-radius: 3px;"></div>
                                                <MudText Typo="Typo.body2" Style="color: #374151;">Días Festivos ($20/persona)</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Style="color: #B97A40; font-weight: 700;">
                                                @dto.ReservasGerenciaFestivo (@pctFestivo.ToString("F0")%)
                                            </MudText>
                                        </MudStack>
                                        <div class="bar-bg">
                                            <div class="bar-fill" style="@($"width: {pctFestivo}%; background: #E8A668;")"></div>
                                        </div>
                                    </div>
                                </MudStack>

                                <MudDivider Class="my-3" Style="border-color: #E5E7EB;" />

                                <MudGrid>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">Total reservas</MudText>
                                        <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">@total</MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">Total recaudado</MudText>
                                        <MudText Typo="Typo.h6" Style="color: #5C9163; font-weight: 700;">$@dto.IngresosGerenciaMes.ToString("N0")</MudText>
                                    </MudItem>
                                </MudGrid>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="color: #6B7280;">Sin reservas de gerencia este mes</MudText>
                            }
                        </MudPaper>
                    </MudItem>

                    <!-- Comparativa Gerencia vs Total -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px; height: 100%;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #EFF5EF; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Style="color: #6FA776; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Gerencia vs Ingresos Totales</MudText>
                            </MudStack>

                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280;">Ingresos del Mes</MudText>
                                        <MudText Typo="Typo.h5" Style="color: #1F2937; font-weight: 700;">
                                            $@dto.IngresosMes.ToString("N0") <span style="color: #6B7280; font-size: 14px; font-weight: 400;">total</span>
                                        </MudText>
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12">
                                    <div style="background: #F0F2F5; border-radius: 8px; height: 32px; position: relative; overflow: hidden;">
                                        @{
                                            double pctGerencia = dto.IngresosMes > 0 ? (double)((dto.IngresosGerenciaMes / dto.IngresosMes) * 100m) : 0;
                                            double pctOtros = 100 - pctGerencia;
                                        }
                                        <div style="@($"width: {pctGerencia}%; height: 100%; background: linear-gradient(90deg, #424E5F 0%, #2E3744 100%); display: inline-block;")"></div>
                                    </div>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <div style="width: 10px; height: 10px; background: #424E5F; border-radius: 2px;"></div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">Gerencia</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.body2" Style="color: #424E5F; font-weight: 700;">
                                            $@dto.IngresosGerenciaMes.ToString("N0") (@pctGerencia.ToString("F0")%)
                                        </MudText>
                                    </MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                            <div style="width: 10px; height: 10px; background: #6FA776; border-radius: 2px;"></div>
                                            <MudText Typo="Typo.caption" Style="color: #6B7280;">Otros ingresos</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.body2" Style="color: #5C9163; font-weight: 700;">
                                            $@((dto.IngresosMes - dto.IngresosGerenciaMes).ToString("N0")) (@pctOtros.ToString("F0")%)
                                        </MudText>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <!-- Reservas de Gerencia recientes -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #F0F2F5; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Style="color: #424E5F; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Reservas de Gerencia Recientes</MudText>
                            </MudStack>

                            @if (dto.ReservasGerenciaRecientes.Any())
                            {
                                <MudTable Items="@dto.ReservasGerenciaRecientes" Hover="true" Dense="true">
                                    <HeaderContent>
                                        <MudTh>Cliente</MudTh>
                                        <MudTh>Habitación</MudTh>
                                        <MudTh>Entrada</MudTh>
                                        <MudTh>Salida</MudTh>
                                        <MudTh>Estado</MudTh>
                                        <MudTh Style="text-align: right;">Total</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Cliente</MudTd>
                                        <MudTd>@context.Habitacion</MudTd>
                                        <MudTd>@context.FechaEntrada.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd>@context.FechaSalida.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd>
                                            <MudChip Size="Size.Small" Variant="Variant.Text"
                                                     Style="@GetEstiloEstadoChip(context.Estado)">
                                                @context.Estado
                                            </MudChip>
                                        </MudTd>
                                        <MudTd Style="text-align: right; color: #5C9163; font-weight: 700;">
                                            $@context.Total.ToString("N2")
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
