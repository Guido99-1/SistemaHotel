                                    <div style="background: #EBF2F9; padding: 8px; border-radius: 8px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Style="color: #5C8DC2; font-size: 20px;" />
                                    </div>
                                    <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Próximos Check-ins (7 días)</MudText>
                                </MudStack>
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="@(() => _navManager.NavigateTo("/page/reservas"))"
                                           Style="border-color: #D1D5DB; color: #374151; text-transform: none;">
                                    Ver todas
                                </MudButton>
                            </MudStack>

                            @if (dto.ProximosCheckIns.Any())
                            {
                                <MudTable Items="@dto.ProximosCheckIns" Hover="true" Dense="true">
                                    <HeaderContent>
                                        <MudTh>Cliente</MudTh>
                                        <MudTh>Habitación</MudTh>
                                        <MudTh>Entrada</MudTh>
                                        <MudTh>Salida</MudTh>
                                        <MudTh>Estado</MudTh>
                                        <MudTh Style="text-align: right;">Total</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Cliente</MudTd>
                                        <MudTd>@context.Habitacion</MudTd>
                                        <MudTd>
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body2">@context.FechaEntrada.ToString("dd/MM/yyyy")</MudText>
