                                        <MudText Typo="Typo.h4" Style="color: #4A7AAD; font-weight: 700;">@dto.ReservasConfirmadas</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudPaper Class="pa-3 text-center" Elevation="0"
                                              Style="background: #EFF5EF; border-left: 3px solid #6FA776; border-radius: 8px;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">FINALIZADAS</MudText>
                                        <MudText Typo="Typo.h4" Style="color: #5C9163; font-weight: 700;">@dto.ReservasFinalizadas</MudText>
