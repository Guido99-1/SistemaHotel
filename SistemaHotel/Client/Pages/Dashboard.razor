                                            </MudStack>
                                        </MudTd>
                                        <MudTd>@context.FechaSalida.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd>
                                            <MudChip Size="Size.Small" Variant="Variant.Text"
                                                     Style="@GetEstiloEstadoChip(context.Estado)">
                                                @context.Estado
                                            </MudChip>
                                        </MudTd>
                                        <MudTd Style="text-align: right; font-weight: 600;">
                                            $@context.Total.ToString("N2")
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                    No hay check-ins programados en los próximos 7 días.
                                </MudAlert>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 4: RANKINGS -->
            <MudTabPanel Text="Rankings" Icon="@Icons.Material.Filled.Leaderboard">
