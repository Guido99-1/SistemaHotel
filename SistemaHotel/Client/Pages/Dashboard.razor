                                        <MudText Typo="Typo.h4" Style="color: #424E5F; font-weight: 700;">@dto.ReservasCanceladas</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <!-- Próximos Check-ins -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
