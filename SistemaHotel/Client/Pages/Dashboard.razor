                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <div style="background: #EBF2F9; padding: 8px; border-radius: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Style="color: #5C8DC2; font-size: 20px;" />
                                </div>
                                <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;">Top 5 Habitaciones</MudText>
                            </MudStack>

                            @if (dto.TopHabitaciones.Any())
                            {
                                <MudList Clickable="false" DisablePadding="true">
                                    @{ int idx = 1; }
                                    @foreach (var h in dto.TopHabitaciones)
                                    {
                                        <MudListItem Class="pa-2">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width: 100%;">
                                                <div style="@GetEstiloAvatar(idx)">@idx</div>
                                                <MudStack Spacing="0" Style="flex: 1;">
                                                    <MudText Typo="Typo.body2" Style="color: #1F2937; font-weight: 600;">Habitación @h.Numero</MudText>
                                                    <MudText Typo="Typo.caption" Style="color: #6B7280;">
                                                        @h.Categoria · @h.VecesOcupada veces
