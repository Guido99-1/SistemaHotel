                                </MudAlert>
                            }
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudTabPanel>

            <!-- TAB 3: ESTADOS Y RESERVAS -->
            <MudTabPanel Text="Estados" Icon="@Icons.Material.Filled.PieChart">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid #E5E7EB; border-radius: 12px;">
                            <MudText Typo="Typo.h6" Style="color: #1F2937; font-weight: 700;" Class="mb-3">Estados de Reservas (Mes)</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="6" sm="3">
