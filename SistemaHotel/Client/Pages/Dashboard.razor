                                              Style="background: #FAF1E7; border-left: 3px solid #E8A668; border-radius: 8px;">
                                        <MudText Typo="Typo.caption" Style="color: #6B7280; font-size: 11px; letter-spacing: 0.5px;">RESERVADAS</MudText>
